// data/src/main/java/{basePackagePath}/data/local/database/entity/{Entity}Entity.kt
package {basePackage}.data.local.database.entity

import androidx.room3.ColumnInfo
import androidx.room3.Entity
import androidx.room3.Index
import androidx.room3.PrimaryKey

@Entity(
    tableName = "{entities_table}",
    indices = [
        Index(value = ["server_id"], unique = true),
        Index(value = ["server_update_seq"], unique = true),
        Index(value = ["updated_at"], orders = [Index.Order.DESC]),   // DECISION: one index per real WHERE / ORDER BY
        Index(value = ["is_synced"]),
    ]
    // DECISION: child of another table → foreignKeys = [ForeignKey(entity = ParentEntity::class,
    //     parentColumns = ["id"], childColumns = ["parent_id"], onDelete = ForeignKey.CASCADE)]
)
internal data class {Entity}Entity(
    @PrimaryKey(true) val id: Long,
    @ColumnInfo("server_id") val serverId: Long?,
    @ColumnInfo("server_update_seq") val serverUpdateSeq: Long?,
    @ColumnInfo("is_synced") val isSynced: Boolean,
    val title: String,
    val desc: String?,
    @ColumnInfo("created_at") val createdAt: Long,
    @ColumnInfo("updated_at") val updatedAt: Long
)
