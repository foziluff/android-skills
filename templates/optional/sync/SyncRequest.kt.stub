@Serializable
internal data class Sync{Entities}Request(
    val {entities}: List<{Entity}RequestDto>,
    @SerialName("deleted_ids") val deletedIds: List<Long>,
    @SerialName("confirmed_deleted_ids") val confirmedDeletedIds: List<Long>,
    @SerialName("client_update_seq") val clientUpdateSeq: Long
)
