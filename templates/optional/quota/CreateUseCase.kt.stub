// domain/src/main/java/{basePackagePath}/domain/usecase/{area}/Create{Entity}UseCase.kt
package {basePackage}.domain.usecase.{area}

import {basePackage}.domain.error.{Entity}Error
import {basePackage}.domain.gateway.TransactionRunner
import {basePackage}.domain.repository.{Entity}Repository
import {basePackage}.domain.repository.SyncRepository
import {basePackage}.domain.repository.UserRepository
import {basePackage}.domain.specification.CanAdd{Entity}Specification
import {basePackage}.domain.validation.{Entity}InputValidator
import {basePackage}.domain.value.Result
import {basePackage}.domain.value.onSuccess
import kotlinx.coroutines.flow.firstOrNull
import javax.inject.Inject

class Create{Entity}UseCase @Inject constructor(
    private val {entity}Repository: {Entity}Repository,
    private val userRepository: UserRepository,
    private val transactionRunner: TransactionRunner,
    private val validator: {Entity}InputValidator,
    private val specification: CanAdd{Entity}Specification,
    private val syncRepository: SyncRepository,      // DECISION: only with optional/sync — otherwise drop it and .onSuccess { sync }
) {
    data class Params(
        val title: String,
        val desc: String?
    )

    suspend operator fun invoke(params: Params): Result<Long, {Entity}Error> {
        val clearTitle = params.title.trim()
        val clearDesc = params.desc?.trim()?.ifBlank { null }

        validator.validate(title = clearTitle, desc = clearDesc)?.let { return Result.error(it) }

        return transactionRunner.withWriteTransaction {
            val currentCount = {entity}Repository.getCount()
            // DECISION: the app's source of the paid flag (reference: User cached after /me)
            val isPro = userRepository.observe().firstOrNull()?.isPro == true

            specification.check(
                currentCount = currentCount,
                isPro = isPro
            )?.let { return@withWriteTransaction Result.error(it) }

            val {entity}Id = {entity}Repository.create(title = clearTitle, desc = clearDesc)

            Result.success({entity}Id)
        }.onSuccess {
            syncRepository.sync()
        }
    }
}
