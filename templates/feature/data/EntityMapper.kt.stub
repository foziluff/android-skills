package {basePackage}.data.mapper

import {basePackage}.data.local.database.entity.{Entity}Entity
import {basePackage}.domain.entity.{Entity}
import java.time.Instant

internal fun {Entity}Entity.toDomain() = {Entity}(
    id = id,
    title = title,
    desc = desc,
    createdAt = Instant.ofEpochMilli(createdAt),
    updatedAt = Instant.ofEpochMilli(updatedAt)
)
