// data/src/main/java/{basePackagePath}/data/repository/{Entity}RepositoryImpl.kt
package {basePackage}.data.repository

import androidx.paging.Pager
import androidx.paging.PagingConfig
import androidx.paging.PagingData
import androidx.paging.map
import androidx.room3.RoomRawQuery
import {basePackage}.data.local.database.dao.{Entity}Dao
import {basePackage}.data.local.database.entity.{Entity}Entity
import {basePackage}.data.mapper.toDomain
import {basePackage}.domain.entity.{Entity}
import {basePackage}.domain.repository.{Entity}Repository
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map
import javax.inject.Inject

internal class {Entity}RepositoryImpl @Inject constructor(
    private val {entity}Dao: {Entity}Dao,
) : {Entity}Repository {
    override fun observePaged(searchQuery: String?): Flow<PagingData<{Entity}>> = Pager(
        config = PagingConfig(
            pageSize = PAGE_SIZE,
            prefetchDistance = PREFETCH_DISTANCE,
            initialLoadSize = PAGE_SIZE
        ),
        pagingSourceFactory = { {entity}Dao.pagingSource(pagingConstructQuery(searchQuery)) }
    ).flow.map { pagingData ->
        pagingData.map { {entity}Entity -> {entity}Entity.toDomain() }
    }

    override fun observe({entity}Id: Long): Flow<{Entity}?> =
        {entity}Dao.loadById({entity}Id).map { {entity}Entity -> {entity}Entity?.toDomain() }

    override suspend fun create(title: String, desc: String?): Long {
        val now = System.currentTimeMillis()
        return {entity}Dao.insert(
            {entity} = {Entity}Entity(
                id = 0L,
                title = title,
                desc = desc,
                createdAt = now,
                updatedAt = now
            )
        )
    }

    override suspend fun update(id: Long, title: String, desc: String?) = {entity}Dao.update(
        id = id,
        title = title,
        desc = desc,
        updatedAt = System.currentTimeMillis()
    )

    override suspend fun delete({entity}Ids: List<Long>) = {entity}Dao.delete({entity}Ids)

    override suspend fun getCount(): Int = {entity}Dao.getCount()

    private fun pagingConstructQuery(searchQuery: String?): RoomRawQuery {
        val order: String
        var statementSearchQuery: String? = null

        var sql = if (searchQuery.isNullOrBlank()) {
            order = "updated_at DESC"
            "SELECT * FROM {entities_table}"
        } else {
            order = "e.updated_at DESC"
            statementSearchQuery = searchQuery
            """
                SELECT e.* FROM {entities_table} AS e
                JOIN {entities_table}_fts AS f ON f.rowid = e.id
                WHERE {entities_table}_fts MATCH ? || '*'
            """.trimIndent()
        }

        sql += " ORDER BY $order"

        return RoomRawQuery(
            sql = sql,
            onBindStatement = { statement ->
                statementSearchQuery?.let { statement.bindText(1, it) }
            }
        )
    }

    companion object {
        private const val PAGE_SIZE = 30
        private const val PREFETCH_DISTANCE = 10
    }
}
