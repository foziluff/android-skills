package {basePackage}.presentation.feature.{area}.add

import androidx.compose.ui.text.input.TextFieldValue

internal sealed interface Add{Entity}Intent {
    data class TitleChanged(val value: TextFieldValue) : Add{Entity}Intent

    data class DescChanged(val value: TextFieldValue) : Add{Entity}Intent

    data object SaveClicked : Add{Entity}Intent
}
