<!-- config/lint/lint.xml -->
<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- One source of truth for texts: every string is a resource, in every locale -->
    <issue id="HardcodedText" severity="error" />
    <issue id="SetTextI18n" severity="error" />
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <issue id="StringFormatInvalid" severity="error" />
    <issue id="StringFormatCount" severity="error" />
    <issue id="UnusedResources" severity="error" />
    <!-- Security -->
    <issue id="ExportedService" severity="error" />
    <issue id="ExportedReceiver" severity="error" />
    <issue id="UnsafeImplicitIntentLaunch" severity="error" />
    <issue id="LogNotTimber" severity="ignore" />
    <issue id="LogConditional" severity="error" />
    <!-- Always the latest versions: outdated dependencies are reported on every lint run
         (warnings, so a third-party release does not break CI; the checklist requires zero of them) -->
    <issue id="GradleDependency" severity="warning" />
    <issue id="NewerVersionAvailable" severity="warning" />
    <issue id="AndroidGradlePluginVersion" severity="warning" />
</lint>
