// build-logic/convention/src/main/kotlin/ProjectExtensions.kt
import com.android.build.api.dsl.CommonExtension
import com.android.build.api.dsl.Lint
import dev.detekt.gradle.extensions.DetektExtension
import org.gradle.api.Project
import org.gradle.api.artifacts.VersionCatalog
import org.gradle.api.artifacts.VersionCatalogsExtension
import org.gradle.kotlin.dsl.configure
import org.gradle.kotlin.dsl.getByType
import org.jetbrains.kotlin.gradle.dsl.KotlinProjectExtension

internal val Project.libs: VersionCatalog
    get() = extensions.getByType<VersionCatalogsExtension>().named("libs")

internal fun VersionCatalog.intVersion(alias: String): Int = findVersion(alias).get().requiredVersion.toInt()

internal fun Project.configureAndroid(extension: CommonExtension) {
    extension.apply {
        compileSdk {
            version = release(libs.intVersion("compileSdk")) {
                minorApiLevel = libs.intVersion("minorApiLevel")
            }
        }
        defaultConfig.minSdk = libs.intVersion("minSdk")
    }
    configureKotlin()
}

internal fun Project.configureLint(lint: Lint) {
    lint.lintConfig = rootProject.file("config/lint/lint.xml")
    lint.abortOnError = true
}

internal fun Project.configureKotlin() {
    extensions.configure<KotlinProjectExtension> {
        jvmToolchain(libs.intVersion("jdkVersion"))
    }
    configureDetekt()
}

private fun Project.configureDetekt() {
    pluginManager.apply(libs.findPlugin("detekt").get().get().pluginId)
    extensions.configure<DetektExtension> {
        buildUponDefaultConfig.set(true)
        config.setFrom(rootProject.file("config/detekt/detekt.yml"))
    }
}
