// data/build.gradle.kts
plugins {
    alias(libs.plugins.{appName}.android.library)
    alias(libs.plugins.{appName}.hilt)
    // Kotlin serialization
    alias(libs.plugins.jetbrains.kotlin.serialization)
}

android {
    namespace = "{basePackage}.data"

    buildTypes {
        // DECISION: real hosts; never commit credentials
        debug {
            buildConfigField("String", "BASE_URL", "\"https://staging.example.com/api/\"")
        }
        release {
            buildConfigField("String", "BASE_URL", "\"https://api.example.com/api/\"")
        }
    }
    buildFeatures {
        buildConfig = true
    }
}

ksp {
    arg("room.schemaLocation", "$projectDir/schemas")
}

dependencies {
    // Modules
    implementation(project(":domain"))
    implementation(project(":core"))

    // Room3
    implementation(libs.bundles.room3)
    ksp(libs.room3.compiler)
    // Datastore
    implementation(libs.datastore.preferences)
    // Kotlin serialization
    implementation(libs.kotlinx.serialization.json)
    // Retrofit
    implementation(libs.bundles.retrofit)

    androidTestImplementation(libs.androidx.junit)
    androidTestImplementation(libs.kotlinx.coroutines.test)
}
