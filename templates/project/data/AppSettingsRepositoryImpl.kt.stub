// data/src/main/java/{basePackagePath}/data/repository/AppSettingsRepositoryImpl.kt
package {basePackage}.data.repository

import androidx.datastore.core.DataStore
import androidx.datastore.preferences.core.Preferences
import androidx.datastore.preferences.core.edit
import androidx.datastore.preferences.core.stringPreferencesKey
import {basePackage}.domain.repository.AppSettingsRepository
import {basePackage}.domain.value.AppSettings
import {basePackage}.domain.value.AppTheme
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.distinctUntilChanged
import kotlinx.coroutines.flow.map
import javax.inject.Inject

internal class AppSettingsRepositoryImpl @Inject constructor(
    private val dataStore: DataStore<Preferences>
) : AppSettingsRepository {
    private val themeKey = stringPreferencesKey("theme")

    override fun observe(): Flow<AppSettings> = dataStore.data.map { preferences ->
        AppSettings(
            theme = preferences[themeKey]?.let { AppTheme.valueOf(it) } ?: AppSettings.Default.theme,
        )
    }.distinctUntilChanged()

    override suspend fun updateTheme(theme: AppTheme) {
        dataStore.edit { preferences ->
            preferences[themeKey] = theme.name
        }
    }
}
