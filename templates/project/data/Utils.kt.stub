// data/src/main/java/{basePackagePath}/data/remote/Utils.kt
package {basePackage}.data.remote

import {basePackage}.domain.error.NetworkError
import {basePackage}.domain.value.Result
import kotlinx.coroutines.CancellationException
import retrofit2.Response
import java.io.IOException
import java.net.ConnectException
import java.net.SocketTimeoutException
import java.net.UnknownHostException

internal inline fun <T> safeApiCall(
    block: () -> Response<T>,
): Result<T, NetworkError> = try {
    val response = block()
    if (response.isSuccessful) {
        val body = response.body()
        requireNotNull(body)

        Result.success(body)
    } else {
        Result.error(NetworkError.Network(response.code()))
    }
} catch (_: UnknownHostException) {
    Result.error(NetworkError.UnknownHost)
} catch (_: SocketTimeoutException) {
    Result.error(NetworkError.SocketTimeout)
} catch (_: ConnectException) {
    Result.error(NetworkError.Connect)
} catch (_: IOException) {
    Result.error(NetworkError.IO)
} catch (e: CancellationException) {
    throw e
} catch (_: Exception) {
    Result.error(NetworkError.Any)
}