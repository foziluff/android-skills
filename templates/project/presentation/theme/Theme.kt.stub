// presentation/src/main/java/{basePackagePath}/presentation/ui/theme/Theme.kt
package {basePackage}.presentation.ui.theme

import androidx.activity.compose.LocalActivity
import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.LocalContentColor
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.SideEffect
import androidx.core.view.WindowCompat
import {basePackage}.domain.value.AppTheme
import {basePackage}.presentation.util.LocalAppSettings

private val DarkColorScheme = darkColorScheme(
    primary = Green70,
    onPrimary = Gray5,
    secondaryContainer = Green20,
    onSecondaryContainer = Green95,
    tertiary = Gray60,
    onTertiary = Gray5,
    background = Gray5,
    onBackground = Gray99,
    surface = Gray5,
    onSurface = Gray99,
    onSurfaceVariant = Gray60,
    surfaceContainerLow = Gray10,
    surfaceContainerHigh = Gray10,
    surfaceContainerHighest = Gray10,
    surfaceContainer = Gray5,
    inverseSurface = WarmGray95,
    inverseOnSurface = Gray20,
    outline = Gray50,
    outlineVariant = Gray20,
    error = Red60,
    scrim = Black
)

private val LightColorScheme = lightColorScheme(
    primary = Green60,
    onPrimary = White,
    secondaryContainer = Green95,
    onSecondaryContainer = Green40,
    tertiary = Gray40,
    onTertiary = White,
    background = White,
    onBackground = Gray5,
    surface = White,
    onSurface = Gray5,
    onSurfaceVariant = Gray40,
    surfaceContainerLow = White,
    surfaceContainerHigh = White,
    surfaceContainerHighest = WarmGray95,
    surfaceContainer = White,
    inverseSurface = Gray20,
    inverseOnSurface = WarmGray95,
    outline = Gray60,
    outlineVariant = Green98,
    error = Red50,
    scrim = Black
)

private val AppDarkColorScheme = AppColorScheme(
    surface = Gray20,
    onSurface = Green80,
    onSurfaceVariant = Gray99,
    link = Blue60,
    gradients = listOf(
        GradientBlueStart to GradientBlueEnd,
        GradientRedOrangeStart to GradientRedOrangeEnd,
        GradientPurpleStart to GradientPurpleEnd,
        GradientPinkStart to GradientPinkEnd,
        GradientGreenStart to GradientGreenEnd,
        GradientYellowStart to GradientYellowEnd,
    ),
    outline = Gray20,
    outlineVariant = Black,
    scrim = White,
    warning = Yellow60,
    staticColor = Gray5,
    surfaceContainer = Yellow60,
    onPrimaryContainer = Gray5,
    tertiaryContainer = Gray30,
    secondaryContainer = Green60,
)

private val AppLightColorScheme = AppColorScheme(
    surface = White,
    onSurface = Green50,
    onSurfaceVariant = Green60,
    link = Blue50,
    gradients = listOf(
        GradientBlueStart to GradientBlueEnd,
        GradientRedOrangeStart to GradientRedOrangeEnd,
        GradientPurpleStart to GradientPurpleEnd,
        GradientPinkStart to GradientPinkEnd,
        GradientGreenStart to GradientGreenEnd,
        GradientYellowStart to GradientYellowEnd,
    ),
    outline = Gray98,
    outlineVariant = Gray99,
    scrim = White,
    warning = Yellow40,
    staticColor = Gray5,
    surfaceContainer = Yellow90,
    onPrimaryContainer = Yellow40,
    tertiaryContainer = Green95,
    secondaryContainer = Green40,
)

private val defaultSpacing = Spacing()
private val defaultSizing = Sizing()

@Composable
internal fun {App}Theme(
    content: @Composable () -> Unit
) {
    val appSettings = LocalAppSettings.current

    val darkTheme = when (appSettings.theme) {
        AppTheme.DARK -> true
        AppTheme.LIGHT -> false
        AppTheme.SYSTEM -> isSystemInDarkTheme()
    }

    val colorScheme = if (darkTheme) DarkColorScheme else LightColorScheme
    val appColorScheme = if (darkTheme) AppDarkColorScheme else AppLightColorScheme

    SystemBarEffect(!darkTheme)

    CompositionLocalProvider(
        LocalAppColorScheme provides appColorScheme,
        LocalContentColor provides colorScheme.onSurface,
        LocalSpacing provides defaultSpacing,
        LocalSizing provides defaultSizing,
    ) {
        MaterialTheme(
            colorScheme = colorScheme,
            typography = Typography,
            content = content
        )
    }
}

@Composable
internal fun SystemBarEffect(isAppearanceLight: Boolean) {
    val window = LocalActivity.current?.window

    if (window != null) {
        SideEffect {
            WindowCompat.getInsetsController(window, window.decorView).apply {
                isAppearanceLightStatusBars = isAppearanceLight
                isAppearanceLightNavigationBars = isAppearanceLight
            }
        }
    }
}
