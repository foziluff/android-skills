// presentation/src/main/java/{basePackagePath}/presentation/component/GestureAnimationContent.kt
package {basePackage}.presentation.component

import androidx.compose.animation.core.Animatable
import androidx.compose.animation.core.keyframes
import androidx.compose.animation.core.spring
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.BoxScope
import androidx.compose.runtime.Composable
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.remember
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.graphicsLayer

@Composable
internal fun GestureAnimationContent(
    isPressed: Boolean,
    modifier: Modifier = Modifier,
    boundEffect: Boolean = false,
    scaleEffect: Float = DEFAULT_SCALE_EFFECT,
    content: @Composable BoxScope.() -> Unit,
) {
    val scale = remember { Animatable(1f) }

    LaunchedEffect(isPressed) {
        scale.animateTo(
            targetValue = if (isPressed) 1f - scaleEffect else 1f,
            animationSpec = if (isPressed) spring() else keyframes {
                durationMillis = RELEASE_DURATION_MILLIS
                RELEASE_OVERSHOOT_SCALE at RELEASE_OVERSHOOT_START_MILLIS
                RELEASE_OVERSHOOT_SCALE at RELEASE_OVERSHOOT_END_MILLIS
            }
        )
    }

    LaunchedEffect(boundEffect) {
        if (!boundEffect) return@LaunchedEffect

        if (scale.isRunning) scale.stop()
        scale.animateTo(
            targetValue = 1f,
            animationSpec = keyframes {
                durationMillis = BOUNCE_DURATION_MILLIS
                BOUNCE_UP_SCALE at BOUNCE_UP_MILLIS
                BOUNCE_DOWN_SCALE at BOUNCE_DOWN_MILLIS
            }
        )
    }

    Box(
        modifier = modifier.graphicsLayer {
            scaleX = scale.value
            scaleY = scale.value
        },
        content = content
    )
}

internal const val BUTTON_PRESS_SCALE_EFFECT = 0.02f
private const val DEFAULT_SCALE_EFFECT = 0.1f
private const val RELEASE_DURATION_MILLIS = 300
private const val RELEASE_OVERSHOOT_SCALE = 1.01f
private const val RELEASE_OVERSHOOT_START_MILLIS = 100
private const val RELEASE_OVERSHOOT_END_MILLIS = 200
private const val BOUNCE_DURATION_MILLIS = 600
private const val BOUNCE_UP_SCALE = 1.1f
private const val BOUNCE_UP_MILLIS = 200
private const val BOUNCE_DOWN_SCALE = 0.96f
private const val BOUNCE_DOWN_MILLIS = 400
