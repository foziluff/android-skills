// presentation/src/main/java/{basePackagePath}/presentation/component/AppButton.kt
package {basePackage}.presentation.component

import androidx.compose.animation.AnimatedContent
import androidx.compose.foundation.interaction.MutableInteractionSource
import androidx.compose.foundation.interaction.collectIsPressedAsState
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.Spacer
import androidx.compose.foundation.layout.size
import androidx.compose.foundation.layout.width
import androidx.compose.material3.Button
import androidx.compose.material3.ButtonDefaults
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.material3.LocalContentColor
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.getValue
import androidx.compose.runtime.remember
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import {basePackage}.presentation.ui.theme.sizing
import {basePackage}.presentation.ui.theme.spacing

@Composable
internal fun AppButton(
    text: String,
    modifier: Modifier = Modifier,
    enabled: Boolean = true,
    progress: Boolean = false,
    contentColor: Color = LocalContentColor.current,
    containerColor: Color = MaterialTheme.colorScheme.primary,
    icon: @Composable (() -> Unit)? = null,
    onClick: () -> Unit
) {
    val interactionSource = remember { MutableInteractionSource() }
    val isPressed by interactionSource.collectIsPressedAsState()

    CompositionLocalProvider(LocalContentColor provides contentColor) {
        GestureAnimationContent(
            isPressed = isPressed,
            scaleEffect = BUTTON_PRESS_SCALE_EFFECT
        ) {
            Button(
                onClick = onClick,
                modifier = modifier,
                enabled = enabled && !progress,
                colors = ButtonDefaults.buttonColors(
                    containerColor = containerColor
                ),
                interactionSource = interactionSource
            ) {
                AnimatedContent(
                    progress
                ) { state ->
                    if (state) CircularProgressIndicator(
                        modifier = Modifier.size(MaterialTheme.sizing.iconExtraSmall),
                        color = LocalContentColor.current,
                        strokeWidth = MaterialTheme.sizing.circularStrokeWidth
                    ) else Row(
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        icon?.let {
                            icon()
                            Spacer(Modifier.width(MaterialTheme.spacing.space100))
                        }
                        Text(
                            text = text
                        )
                    }
                }
            }
        }
    }
}
