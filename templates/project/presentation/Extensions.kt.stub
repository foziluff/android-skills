// presentation/src/main/java/{basePackagePath}/presentation/util/Extensions.kt
package {basePackage}.presentation.util

import android.app.Activity
import android.content.ActivityNotFoundException
import android.content.Context
import android.content.Intent
import android.net.Uri
import androidx.compose.foundation.gestures.detectTapGestures
import androidx.compose.ui.Modifier
import androidx.compose.ui.focus.FocusRequester
import androidx.compose.ui.input.pointer.pointerInput
import androidx.compose.ui.text.input.TextFieldValue

internal fun FocusRequester.requestFocusCatch() = try {
    requestFocus()
} catch (_: Exception) {
}

internal fun TextFieldValue.exceeds(maxLength: Int): Boolean = text.trim().length > maxLength

internal fun Context.openUri(uri: Uri, action: String = Intent.ACTION_VIEW) {
    try {
        val intent = Intent(action, uri).apply {
            if (this@openUri !is Activity) {
                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            }
        }
        startActivity(intent)
    } catch (_: ActivityNotFoundException) {
    }
}

internal fun Context.shareText(text: String) {
    val intent = Intent(Intent.ACTION_SEND).apply {
        type = MIME_TEXT_PLAIN
        putExtra(Intent.EXTRA_TEXT, text)
    }
    val chooser = Intent.createChooser(intent, null).apply {
        if (this@shareText !is Activity) {
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        }
    }
    startActivity(chooser)
}

internal fun Modifier.hideKeyboard(
    controller: KeyboardController,
    clearFocus: Boolean = true
): Modifier = pointerInput(controller, clearFocus) {
    detectTapGestures(onTap = { controller.hide(clearFocus) })
}

private const val MIME_TEXT_PLAIN = "text/plain"
