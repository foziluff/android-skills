// presentation/src/main/java/{basePackagePath}/presentation/feature/main/MainScreen.kt
package {basePackage}.presentation.feature.main

import androidx.compose.foundation.background
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.padding
import androidx.compose.foundation.layout.statusBarsPadding
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.SnackbarHost
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.getValue
import androidx.compose.ui.Modifier
import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import {basePackage}.presentation.component.AppTopSnackbar
import {basePackage}.presentation.navigation.NavGraph
import {basePackage}.presentation.navigation.TopLevelScreen
import {basePackage}.presentation.navigation.rememberNavBackStack
import {basePackage}.presentation.ui.theme.{App}Theme
import {basePackage}.presentation.ui.theme.sizing
import {basePackage}.presentation.util.LocalAppSettings
import {basePackage}.presentation.util.ObserveSnackbarEvents
import {basePackage}.presentation.util.SnackbarController

@Composable
fun MainScreen(
    modifier: Modifier = Modifier
) {
    val viewModel: MainViewModel = hiltViewModel()
    val state by viewModel.state.collectAsStateWithLifecycle()

    ObserveSnackbarEvents()

    CompositionLocalProvider(
        LocalAppSettings provides state.appSettings,
    ) {
        {App}Theme {
            Box(
                modifier = modifier.background(MaterialTheme.colorScheme.background)
            ) {
                val backStack = rememberNavBackStack(TopLevelScreen.startTopLevelScreen)

                NavGraph(
                    backStack = backStack,
                    backHandlerEnabled = true
                )

                SnackbarHost(
                    hostState = SnackbarController.snackbarHostState,
                    modifier = Modifier
                        .statusBarsPadding()
                        .padding(top = MaterialTheme.sizing.topAppBarHeight),
                    snackbar = { AppTopSnackbar(snackbarData = it) }
                )
            }
        }
    }
}
